{
  "name": "gbbrinepond-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "盐湖蒸发池卤水晒程编排台 - 纯前端 SPA（SolidJS + TypeScript + Vite + Solid Router + Tailwind CSS + Dexie）",
  "scripts": {
    "dev": "vite --host --port 22816",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 22816",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.1",
    "dexie": "^4.0.11",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-solid": "^2.11.1"
  }
}
